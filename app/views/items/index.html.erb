

<% content_for :title, "Gallery" %>
   <div class="divider"></div>
<%if notice.present?%>
<p style="color: green"><%= notice %></p>
<%end%>



<div class="container-fluid bg-pale-slate-2">
  <%if current_user %>

   <%= link_to "Add new item", new_item_path , class: "btn btn-primary m-2" %>
  <%end%>


  <div class="container px-4 py-5" id="items">
    <div class="grid" data-controller="masonry-gallery">
    <% cache('item_list', expires_in: 30.minutes) do %>
      <% @items.each do |item| %>
        <%= link_to item do %>
          <%= image_tag item.picture , class: "item grid-item" %>
        <% end %>
      <% end %>
      <%end%>
    </div>
  </div>
</div>
</div>
