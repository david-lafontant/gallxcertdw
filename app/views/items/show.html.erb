<p style="color: green">
  <%= notice %>
</p>

<%= render @item %>
  <div>
    <% if current_user && current_user.admin? %>
      <%= link_to "Edit this item" , edit_item_path(@item), class: "btn btn-warning mb-2 mx-2" %> |
        <%end%>
          <%= link_to "Back to items" , items_path, class: "btn btn-primary mb-2 mx-2" %>
            <% if current_user && current_user.admin? %>
              <%= button_to "Destroy this item" , @item, method: :delete, class: "btn btn-danger mb-2 mx-2" %>
                <%end%>
  </div>
