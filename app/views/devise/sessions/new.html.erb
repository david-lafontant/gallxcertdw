<main class="app-form w-100 m-auto">
  <h2 class="text-center">Log in</h2>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "form") do |f| %>
    <div class="form-floating mb-3">
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      <%= f.label :email %>
    </div>
    <div class="form-floating mb-3">
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password",  class: "form-control"%>
      <%= f.label :password  %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="form-check mb-3">
        <%= f.check_box :remember_me, class: "form-check-input" %>
        <%= f.label :remember_me, class: "form-check-label" %>
      </div>
    <% end %>
    <div class="mb-3 w-100">
      <%= f.submit "Log in", class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <div class="text-center">
    <%= render "devise/shared/links" %>
  </div>
</main>
